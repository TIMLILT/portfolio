# Fichier d'exemple pour les variables d'environnement
# Copier ce fichier vers .env et remplir avec vos valeurs

# Informations de contact
REACT_APP_WHATSAPP_NUMBER=votre_numero_whatsapp
REACT_APP_EMAIL=votre@email.com

# Liens réseaux sociaux
REACT_APP_GITHUB=https://github.com/votre-username
REACT_APP_LINKEDIN=https://www.linkedin.com/in/votre-profile/

# URL du site (pour SEO)
REACT_APP_SITE_URL=https://votre-domaine.com
